# Copy to .env and fill in. Names only here — never a real value.
#   cp .env.example .env
#   export $(grep -v '^#' .env | xargs)

# Which provider the chat layer uses: gemini or ollama. Required.
LLM_PROVIDER=

# --- gemini -----------------------------------------------------------------
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest — an alias, so a key issued later
# does not hit a retired pinned model. Set a specific version to pin.
GEMINI_MODEL=

# --- ollama (local, no key) --------------------------------------------------
# Optional. Defaults to http://localhost:11434
OLLAMA_HOST=
# Optional. Defaults to llama3.1
OLLAMA_MODEL=

# --- both --------------------------------------------------------------------
# Seconds to wait for a reply. Optional. Defaults to 30.
LLM_TIMEOUT_SECONDS=

# --- how the bot reaches the calculators --------------------------------------
# direct: call the Python functions in-process. The default, so a fresh clone
#         runs the test suite without spawning anything.
# mcp:    call them as tools on an MCP server over stdio, started as a child
#         process (python -m mcp_tools.server).
#
# Both give identical answers and identical errors. A calculator exception
# crosses the process boundary as the class it was, with every structured field
# intact, so the chat layer catches the same types either way and formats the
# same sentence — see mcp_tools/wire.py. pytest -q passes in both modes.
CALCULATOR_TRANSPORT=
