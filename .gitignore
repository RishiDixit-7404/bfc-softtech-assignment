# --- Local working notes: not part of the deliverable ---
# Anything personal to one clone belongs in .git/info/exclude, not here.
notes/
scratch/

# --- Secrets ---
# Prefix match, not exact: .env.local, .env.backup and .envgit are all the
# same mistake waiting to happen, and only .env.example is safe to track.
.env*
!.env.example
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
