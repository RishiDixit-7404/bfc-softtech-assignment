# Copy to .env and fill in. Names only here — never a real value.
#   cp .env.example .env
#   export $(grep -v '^#' .env | xargs)

# Which provider the chat layer uses: gemini or ollama. Required.
LLM_PROVIDER=

# --- gemini -----------------------------------------------------------------
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest — an alias, so a key issued later
# does not hit a retired pinned model. Set a specific version to pin.
GEMINI_MODEL=

# --- ollama (local, no key) --------------------------------------------------
# Optional. Defaults to http://localhost:11434
OLLAMA_HOST=
# Optional. Defaults to llama3.1
OLLAMA_MODEL=

# --- both --------------------------------------------------------------------
# Seconds to wait for a reply. Optional. Defaults to 30.
LLM_TIMEOUT_SECONDS=
